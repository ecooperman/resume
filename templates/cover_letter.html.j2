<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ basics.name }} - Cover Letter</title>
<style>
  :root {
    --ink: #1a1d23;
    --muted: #5b6270;
    --rule: #dde1e7;
    --bg: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  .page {
    max-width: 680px;
    margin: 0 auto;
  }
  header {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 14px;
    margin-bottom: 26px;
  }
  h1 {
    font-size: 21px;
    font-weight: 700;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }
  .contact {
    font-size: 12px;
    color: var(--muted);
  }
  .date {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .body p {
    font-size: 13.5px;
    line-height: 1.65;
    margin: 0 0 16px;
    color: var(--ink);
  }
  .body p:last-child { margin-bottom: 0; }

  @media print {
    .page { padding: 0.65in 0.8in; }
  }
</style>
</head>
<body>
  <div class="page">
    <header>
      <h1>{{ basics.name }}</h1>
      <div class="contact">
        {%- set bits = [] -%}
        {%- if basics.email %}{% set _ = bits.append(basics.email) %}{% endif -%}
        {%- if basics.phone %}{% set _ = bits.append(basics.phone) %}{% endif -%}
        {%- if basics.location %}{% set _ = bits.append(basics.location) %}{% endif -%}
        {{ bits | join(' · ') }}
      </div>
    </header>

    <div class="date">{{ today }}</div>

    <div class="body">
      {% for lines in paragraphs %}
      <p>{% for line in lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
      {% endfor %}
    </div>
  </div>
</body>
</html>
